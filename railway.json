{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "nixpacksConfigPath": "/nixpacks.toml"
  },
  "deploy": {
    "startCommand": "npx serve -s build -l 8080",
    "healthcheckPath": "/",
    "healthcheckTimeout": 60,
    "restartPolicyType": "ALWAYS",
    "restartPolicyMaxRetries": 10
  }
}
